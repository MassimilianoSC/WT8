    "db:restore": "node scripts/db/backup-db.mjs restore",
    "templates:compile": "tsx scripts/compile-templates.ts",
    "templates:check": "tsx scripts/compile-templates.ts --check",
    "templates:diff": "tsx scripts/templates-diff.ts",
    "worker": "tsx src/jobs/worker.ts",
    "outbox:requeue": "tsx scripts/db/outbox-requeue.ts",
    "build:ops": "node scripts/build-ops.mjs",
    "test:server:completo": "vitest run tests/server --maxWorkers=2",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc.tsbuildinfo",
    "db:reset": "tsx scripts/reset-local.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "istat:import": "tsx scripts/istat-import.ts"
  },
