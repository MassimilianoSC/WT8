{
  "name": "practicehub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "start": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start:prod": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:anteprima": "node scripts/anteprima.mjs",
