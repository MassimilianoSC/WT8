# PracticeHub — modello del file deploy/.env (K2). Copiare in deploy/.env e compilare. deploy/.env NON va in git.
# Nessun valore qui è un segreto valido: ogni installazione genera i propri (deploy/README.md).

# Nome del progetto Docker: "practicehub" in esercizio, "practicehub-collaudo" sullo stack di prova.
PH_PROJECT=practicehub
# Etichetta dell'immagine (una per aggiornamento, così si può tornare indietro).
PH_TAG=latest
# Database: practicehub_prod in esercizio, practicehub_collaudo sullo stack di prova (mai i nomi della beta).
PH_DB=practicehub_prod

# Copie notturne (K4): cartella su D:, fuori dal disco virtuale di Docker (D-144). Ora di Roma del giro notturno.
PH_BACKUP_DIR=D:/PracticeHub/copie
PH_BACKUP_TIME=01:30
# Export CSV giornaliero per gestore (PR-18): cartella su D: (poi anche la cartella di rete) e ora di Roma.
PH_EXPORT_DIR=D:/PracticeHub/export
PH_EXPORT_TIME=06:30

# Indirizzo con cui gli utenti aprono l'app (HTTPS dal proxy, K3): indirizzo IP fisso della macchina e porta.
PH_PUBLIC_URL=https://INDIRIZZO-IP:8443
# Porta HTTPS pubblicata sulla macchina (8443: la 443 è del proxy dell'intranet).
PH_HTTPS_PORT=8443
# Cartella con practicehub.crt e practicehub.key (certificato creato con mkcert, deploy/README.md).
PH_CERT_DIR=D:/PracticeHub/certificati

# Segreto delle sessioni: lungo e casuale, uno per installazione. Generarlo con:
#   docker run --rm node:20.19-alpine node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Primo amministratore: creato solo se nel database non c'è nessun ADMIN attivo; password da cambiare al primo
# accesso (PR-19, D-173), mai riallineata a questo file.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Avvisi tecnici (K5, D-162): destinatari separati da virgola; li legge il controllo esterno (deploy/watchdog).
PH_ALERT_TO=
# Spazio libero minimo nella cartella delle copie prima dell'avviso (GB).
PH_DISK_MIN_FREE_GB=20
# Spazio libero minimo del disco di sistema (C:) per il controllo esterno (PR-17a), in GB.
PH_DISK_C_MIN_FREE_GB=20

# Protezione del login (PR-22): fallimenti in 15 minuti prima del blocco. Per email sempre attivo. Per indirizzo
# 0 = spento: con Docker Desktop su Windows tutti gli altri PC arrivano con l'indirizzo del gateway di Docker
# (verificato), quindi un limite per indirizzo bloccherebbe tutta l'azienda.
PH_LOGIN_LIMIT_PER_EMAIL=5
PH_LOGIN_LIMIT_PER_IP=0

# Posta (vuoto = le mail finiscono solo nel registro del container).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=PracticeHub <no-reply@practicehub.local>

# Pagina Andamento e permesso Direzione (contratto §15, D-191…D-195). Spenta finché non vale true: si accende dopo la
# partenza (o quando M decide) cambiando questo valore e riavviando l'app.
PH_ANDAMENTO=false

# Assistente AI (contratto §13; D-166…D-172). Spento finché PH_AI_ENABLED non è true; poi l'ADMIN lo accende o lo
# spegne per tutti da Configurazione → Assistente AI (D-169), dove imposta anche i limiti per persona (D-171): i due
# valori qui sotto sono solo quelli iniziali.
PH_AI_ENABLED=false
# vertex = Gemini su Google Cloud (Agent Platform, ex Vertex AI). "fake" = modello finto per le prove, rifiutato
# sul database di esercizio.
PH_AI_PROVIDER=vertex
# Progetto Google Cloud, location e modello. D-179: solo "eu" (multi-regione UE, elaborazione nell'UE), mai
# "global" né regioni fuori UE. Modello: versione stabile (mai preview); D-180, scelto col prototipo A4b del 10/10/2026.
GOOGLE_CLOUD_PROJECT=
PH_AI_LOCATION=eu
PH_AI_MODEL=gemini-3.5-flash-lite
# Ragionamento dei modelli Gemini 3.x: vuoto = predefinito del modello (MINIMAL per i Flash-Lite, LOW per gli altri);
# MINIMAL, LOW, MEDIUM, HIGH. Più alto = più lento e costoso.
PH_AI_THINKING_LEVEL=
# Chiave JSON dell'account di servizio: file FUORI dal repository, montato in sola lettura solo nel servizio app.
# Non copiarla altrove, non incollarla in chat o in mail.
PH_AI_CREDENTIAL_FILE=D:/PracticeHub/segreti/vertex-assistant.json
PH_AI_USER_PER_DAY=30
PH_AI_USER_PER_MINUTE=4
# Domande contemporanee sullo stack e tempo massimo di una risposta (ms).
PH_AI_CONCURRENCY=20
PH_AI_TIMEOUT_MS=20000
# Registro dell'assistente: solo metadati, giorni di conservazione (D-170).
PH_AI_LOG_TTL_DAYS=30
